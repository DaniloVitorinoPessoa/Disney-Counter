# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NAO vai para o Git (esta no .gitignore).
# Em producao, defina estas variaveis no painel do Render.

# Senhas de login dos usuarios (casal1: Danilo/Rafaella; casal2: Pedro/Giovanna):
DANILO_SENHA=
RAFAELLA_SENHA=
PEDRO_SENHA=
GIOVANNA_SENHA=

# Banco de dados:
# - deixe DATABASE_URL vazio/comentado para usar SQLite local
# - na nuvem, cole aqui a connection string do Postgres (Neon)
# DATABASE_URL=

# Chave usada para assinar as sessoes de login (opcional localmente):
# SECRET_KEY=

# Aba "Onde comprar" (busca web, 100% gratis, sem cartao):
# 1) TAVILY faz a busca real na web. Chave gratuita (free tier, sem cartao)
#    em https://app.tavily.com. Sem ela, a aba avisa que nao esta configurada.
# TAVILY_API_KEY=
# 2) GEMINI (opcional) so organiza/explica os resultados em portugues. Chave
#    gratuita em https://aistudio.google.com/apikey. Sem ela, a aba mostra os
#    resultados crus do Tavily.
# GEMINI_API_KEY=
# Opcional: modelo de texto do Gemini (padrao: gemini-flash-latest).
# GEMINI_MODEL=
